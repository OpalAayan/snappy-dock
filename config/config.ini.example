# Snappy Dock example config
#
# Copy this file to:
#
#   ~/.config/snappy-dock/config.ini
#
# Then edit that copy. Keep this file as the reference example.
#
# Format:
#   Key=Value
#   Lines starting with # or ; are comments.
#   Boolean values accept true/false, yes/no, or 1/0.
#
# After editing, restart the dock:
#
#   snappy-dock --restart
#
# The dock reads this file through snappydock-d and applies it in QML.

[Dock]
# Values: bottom, top, left, right.
Position=bottom

# Dock alignment on the screen edge.
# Values: center, start, end.
# For top/bottom docks, start means left and end means right.
# For left/right docks, start means top and end means bottom.
Alignment=center

# Layer-shell layer.
# Higher layers appear above more windows.
# Values: background, bottom, top, overlay.
# IMPORTANT: If Mode=snappy, it is highly recommended to use Layer=overlay
#            when using ExclusiveZone, otherwise fine.
Layer=top

# Stretch the dock window across the whole screen width.
# For left/right docks, this stretches across the full screen height.
FullWidth=false

# Reserve screen space for the dock.
# 0 or off: do not reserve space (floating overlay).
# auto: let the compositor calculate automatically (static mode only).
# Any number: reserve that many pixels.
# IMPORTANT: ExclusiveZone=auto does NOT work in snappy mode due to dynamic
#            geometry changes. Set a fixed pixel value (e.g. ExclusiveZone=48).
ExclusiveZone=0

# Hide the dock when it is not hovered.
# NOTE: Using AutoHide together with ExclusiveZone is not recommended
#       (the reserved space stays even when the dock is hidden), but it works.
AutoHide=true

# Command run by the launcher button.
# Examples:
#   fuzzel
#   rofi -show drun
#   wofi --show drun
LauncherCmd=fuzzel

# Where to place the launcher button.
# Values: start, end, none.
# none = no place dont render 
# tip : pair this with Alignment start and end when FullWidth = true 
LauncherPos=start

# Text or icon for the launcher button.
# "dots" (default), "0", "auto", "none", or empty show the default 9-dot grid.
# Any other string is displayed as text using the configured font.
# Example: 󱄅 (Requires Nerd Font)
LauncherIcon=dots

# Size of the launcher icon.
# 0 means scale automatically to roughly match IconSize.
LauncherIconSize=0

# Show a hover background for the launcher icon.
LauncherHoverBg=false

# Size of the launcher hover background.
# 0 means scale automatically based on IconSize and padding.
LauncherHoverBgSize=0


# Show a hover background for dock icons.
# When true, hovering over a dock icon shows a subtle background highlight.
# Set to false to disable the hover background effect on dock icons.
IconHoverBg=true

# Number of workspaces shown in the right-click "Move to workspace" menu.
# Set this to match how many workspaces you normally use.
WorkspaceCount=5

# Delay in milliseconds before the dock hides after the cursor leaves.
# Lower values = dock disappears faster (more like macOS).
# 0 means hide instantly when the cursor leaves.
# Default: 300 (ms).
HotspotDelay=800

# Dock animation mode.
# static  — fixed-size icons (default).
# snappy  — macOS-style magnification: icons grow under the cursor
#            and push neighbors sideways.
Mode=snappy

# Magnification scale boost for snappy mode.
# 0.0 means no magnification (icons don't grow).
# 0.78 is the default (1.78x peak scale).
# Maximum is 2.0 (3x peak scale).
# Has no effect in static mode.
Magnification=1

# How many neighboring icons are visually affected by magnification.
# Range: 1–6.  1 = only the hovered icon grows.
# 3 (default) = the hovered icon plus ~2 neighbors on each side.
# Higher values produce a wider, gentler curve.
# Has no effect in static mode.
Spread=2

# Gap between icon cells in the dock, in pixels.
# Applies to both static and snappy modes.
# 0 means icons touch with no gap.
IconSpacing=3

# How much magnified icons push neighbors apart in snappy mode.
# 0 means no separation (icons can overlap as they grow).
# 0.5 (default) gives moderate breathing room.
# 1.0 fully preserves the original gap between scaled icons (macOS feel).
# Has no effect in static mode.
RiseSpacing=1


[Icons]

# Icon size in pixels.
# Good values: 32, 40, 48, 56, 64.
IconSize=32.5

# Qt icon theme name. Use default or leave empty for the system theme.
# Example: Tela-dracula
Theme=Tela-dracula

# Icon name used when an app icon cannot be found in the theme.
Fallback=application-x-executable

[Margins]

# Extra space between the dock and each screen edge, in pixels.
Top=0
Bottom=0
Left=0
Right=0

[Font]

# Font family for all text
# Examples: Sans, Inter, Roboto, JetBrainsMono Nerd Font, FiraCode Nerd Font etc.
Family=Rubik

# Font weight: Normal, Bold, Light, Medium, SemiBold
Weight=Bold

